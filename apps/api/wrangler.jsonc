{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vcl-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  // Preserve dashboard-managed environment selection, including EBAY_ENVIRONMENT.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "VISION_PROVIDER": "openrouter",
    // The Gemini 2.5 models have no Zero-Data-Retention endpoint on this account
    // (404 under zdr); the 3.x Flash-Lite line does, and costs a fraction of the
    // OpenAI models for the same comparison.
    "OPENROUTER_MODEL": "google/gemini-3.5-flash-lite",
    // Pinned explicitly: a stale value from an earlier deployment survived the
    // config removal and silently kept the verifier on the gateway. The provider
    // treats this exact string as "native OpenRouter", which is what applies the
    // zero-retention routing block.
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1/chat/completions",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "BRAVE_ENABLED": "false",
    "VERIFIER_MAX_ATTEMPTS": "1",
    "COMMERCE_ELIGIBILITY_GATE": "1",
    "EBAY_ENVIRONMENT": "production",
    "JEV_DECISION_ROUTER": "true",
    "BENCHMARK_MODE": "false",
    "VERIFIED_PRODUCT_TEST_MODE": "false",
    "SCOOP_SIMILAR_ONLY": "true",
    "VISUAL_PRODUCT_INDEX": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDBACK_LEDGER",
        "class_name": "FeedbackLedger"
      },
      {
        "name": "ALPHA_ACCESS_LEDGER",
        "class_name": "AlphaAccessLedger"
      },
      {
        "name": "VERIFIED_PRODUCT_LEDGER",
        "class_name": "VerifiedProductLedger"
      },
      {
        "name": "ADMIN_ACCESS_LEDGER",
        "class_name": "AdminAccessLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-feedback-ledger",
      "new_sqlite_classes": ["FeedbackLedger"]
    },
    {
      "tag": "v2-alpha-access",
      "new_sqlite_classes": ["AlphaAccessLedger"]
    },
    {
      "tag": "v3-verified-product-ledger",
      "new_sqlite_classes": ["VerifiedProductLedger"]
    },
    {
      "tag": "v4-admin-access",
      "new_sqlite_classes": ["AdminAccessLedger"]
    }
  ],
  "ratelimits": [
    {
      "name": "ALPHA_INSTALL_RATE_LIMITER",
      "namespace_id": "11301",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "ALPHA_GLOBAL_RATE_LIMITER",
      "namespace_id": "11302",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "api.vcl.article6.org",
      "custom_domain": true
    }
  ]
}
