{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vcl-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  // Preserve dashboard-managed environment selection, including EBAY_ENVIRONMENT.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "VISION_PROVIDER": "openrouter",
    "OPENROUTER_MODEL": "google/gemini-2.5-flash",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "COMMERCE_ELIGIBILITY_GATE": "1",
    "EBAY_ENVIRONMENT": "production",
    "JEV_DECISION_ROUTER": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDBACK_LEDGER",
        "class_name": "FeedbackLedger"
      },
      {
        "name": "ALPHA_ACCESS_LEDGER",
        "class_name": "AlphaAccessLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-feedback-ledger",
      "new_sqlite_classes": ["FeedbackLedger"]
    },
    {
      "tag": "v2-alpha-access",
      "new_sqlite_classes": ["AlphaAccessLedger"]
    }
  ],
  "ratelimits": [
    {
      "name": "ALPHA_INSTALL_RATE_LIMITER",
      "namespace_id": "11301",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "ALPHA_GLOBAL_RATE_LIMITER",
      "namespace_id": "11302",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "api.vcl.article6.org",
      "custom_domain": true
    }
  ]
}
