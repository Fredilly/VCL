{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vcl-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  // Preserve dashboard-managed environment selection, including EBAY_ENVIRONMENT.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "VISION_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "api.vcl.article6.org",
      "custom_domain": true
    }
  ]
}
